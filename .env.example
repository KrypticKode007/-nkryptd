# ==============================================================================
# NKRYPTD CORE SYSTEM SECURITY ENVIRONMENT SETUP
# ==============================================================================

# Core Service Configuration
NKRYPTD_PORT=8080
NKRYPTD_DATA_DIR=/app/data

# WebSocket Incognito Gateway Credentials
# Generate a strong, 64-character token for production usage:
# Linux terminal command: openssl rand -hex 32
NKRYPTD_GATEWAY_TOKEN=4f7a2b91c83d5e6f0a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f
NKRYPTD_GATEWAY_PORT=19999

# Active Threat Telemetry Outbound Webhook
# The Shaker Protocol will push structured alert documents here live:
NKRYPTD_ALERT_WEBHOOK=https://your-secure-siem-endpoint.local

# Docker Build Configurations
DOCKER_BUILDKIT=1
COMPOSE_CONVERT_WINDOWS_PATHS=1
