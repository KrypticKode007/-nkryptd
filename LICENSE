#!/usr/bin/env bash

# ==============================================================================
# Dual-License Header & Setup Automation Script
#
# Main Entities: nkryptd repo (KrypticKode007), Apache 2.0 / Commercial Licenses
# Functionality: Injects standard dual-licensing headers (Open Source Apache 2.0
#                vs Proprietary Commercial) or updates structural repo properties.
# ==============================================================================

set -euo pipefail

# ------------------------------------------------------------------------------
# Configuration Definitions
# ------------------------------------------------------------------------------
REPO_NAME="nkryptd"
AUTHOR="KrypticKode007 Brandon Mark Wilson"
YEAR=$(date +%Y)

APACHE_SPDX="SPDX-License-Identifier: Apache-2.0"
COMMERCIAL_SPDX="SPDX-License-Identifier: LicenseRef-Commercial-Proprietary"

# ------------------------------------------------------------------------------
# Dual License Header Block
# ------------------------------------------------------------------------------
LICENSE_HEADER_TEMPLATE="/*
 * Copyright (c) ${YEAR} ${AUTHOR}. All rights reserved.
 * 
 * This repository ('${REPO_NAME}') and its source files are dual-licensed:
 * 
 * 1. Open Source Use:
 *    Licensed under the Apache License, Version 2.0 (the \"License\");
 *    you may not use this file except in compliance with the License.
 *    You may obtain a copy of the License at:
 *    http://apache.org
 * 
 * 2. Commercial / Proprietary Use:
 *    For commercial production deployments, closed-source integration, 
 *    or enterprise distributions, you must obtain a separate, valid 
 *    Commercial Execution License directly from the author.
 * 
 * Dual-License Identifiers:
 * - ${APACHE_SPDX}
 * - ${COMMERCIAL_SPDX}
 */"

# ------------------------------------------------------------------------------
# Core Utility Actions
# ------------------------------------------------------------------------------
generate_root_license_declarations() {
    echo "[+] Emitting localized dual-license configuration structures..."

    # Create root level dual declaration file
    cat << EOF > LICENSE.md
# Licensing Terms for ${REPO_NAME}

This project is authored by **${AUTHOR}** and is available under a **dual-licensing model**. 

You may choose to use this software under the terms of either of the following agreements:

## 1. Apache License, Version 2.0 (Open Source)
The open-source edition is distributed under the terms of the Apache License 2.0. 
See the accompanying \`LICENSE-APACHE\` file or read it online at:
[Apache 2.0 License](http://apache.org)

## 2. Commercial & Proprietary License
For production operations, commercial distribution, or closed-source modifications, a separate enterprise or individual commercial agreement is required. Please contact the author directly for operational licensing details.

***

### Compliance Data
- **Primary Open Source Identifier:** \`${APACHE_SPDX}\`
- **Primary Proprietary Identifier:** \`${COMMERCIAL_SPDX}\`
EOF

    echo "[+] Base 'LICENSE.md' initialized successfully."
}

apply_headers_to_source_files() {
    local target_directory="${1:-.}"
    echo "[+] Injecting dual-license structural header blocks to targets in: ${target_directory}"

    # Scan and append headers selectively to targeted implementation code types
    find "$target_directory" -type f \( -name "*.py" -o -name "*.js" -o -name "*.go" \) | while read -r source_file; do
        if ! grep -q "Dual-License Identifiers" "$source_file"; then
            echo "    -> Provisioning header for: $source_file"
            
            # Format block wrapper relative to Python or Script files if necessary
            if [[ "$source_file" == *.py ]]; then
                # Convert template comment characters for standard Python syntax parsing
                local py_header
                py_header=$(echo "$LICENSE_HEADER_TEMPLATE" | sed 's|/\*|#|g; s| \*/|#|g; s| \* |# |g; s| \*|#|g')
                (echo "$py_header"; echo ""; cat "$source_file") > "${source_file}.tmp"
            else
                (echo "$LICENSE_HEADER_TEMPLATE"; echo ""; cat "$source_file") > "${source_file}.tmp"
            fi
            
            mv "${source_file}.tmp" "$source_file"
        fi
    done
    echo "[+] Header injection tasks completed successfully."
}

# ------------------------------------------------------------------------------
# Entry Point Execution Loop
# ------------------------------------------------------------------------------
main() {
    echo "======================================================================"
    echo "Starting Setup Loop: Dual-License Generator Framework"
    echo "Targeting: ${REPO_NAME} Repository"
    echo "======================================================================"
    
    generate_root_license_declarations()
    apply_headers_to_source_files "."
    
    echo "======================================================================"
    echo "[Execution Success] Workspace configuration targets written safely."
    echo "======================================================================"
}

main "$@"
