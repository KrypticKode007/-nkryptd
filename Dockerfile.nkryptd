# Stage 1: Build dependencies cleanly
FROM python:3.11-alpine AS builder

WORKDIR /build
RUN apk add --no-cache gcc musl-dev libffi-dev openssl-dev
COPY requirements.txt .
RUN pip install --no-cache-dir --user -r requirements.txt

# Stage 2: Pristine runtime image isolation
FROM python:3.11-alpine

WORKDIR /app

# Create a restricted, unprivileged runtime group and user account
RUN addgroup -g 999 nkryptd && \
    adduser -D -u 999 -G nkryptd -s /bin/false nkryptd

# Retrieve verified python libraries from builder stage
COPY --from=builder /root/.local /home/nkryptd/.local
COPY headless_defense_monolith.py scrambler.py ./

# Tighten file system permissions: Read-only execution mapping
RUN chown -R root:root /app && \
    chmod -R 555 /app && \
    mkdir -p /app/data && \
    chown -R nkryptd:nkryptd /app/data && \
    chmod 700 /app/data

USER nkryptd
ENV PATH=/home/nkryptd/.local/bin:$PATH

EXPOSE 8080
ENTRYPOINT ["python", "-u", "headless_defense_monolith.py"]
